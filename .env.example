# --- LLM: Azure AI Foundry ----------------------------------------------
# Foundry inference endpoint (e.g. https://<resource>.services.ai.azure.com/models)
AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/models
AZURE_AI_FOUNDRY_KEY=your-foundry-key
AZURE_AI_FOUNDRY_DEPLOYMENT=your-model-deployment-name
AZURE_AI_FOUNDRY_API_VERSION=2024-05-01-preview

# --- Azure Content Understanding (ACU) ----------------------------------
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_CONTENT_UNDERSTANDING_KEY=your-acu-key
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2024-12-01-preview
